# AvC Configuration Template
# Copy this file to .env and adjust variables as needed.

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Redis Configuration (Rolling Window Session Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL Configuration (Telemetry & Threat Logs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=avc
POSTGRES_PASSWORD=avcpassword
POSTGRES_DB=avcdb

# Model Configuration
MODEL_PATH=ai/best_model.onnx
HF_MODEL_REPO=ayush2635/Dhwani-Multilingual-Deepfake-Audio-Detection-Model
